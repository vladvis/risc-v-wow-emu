    local function sync_in()
        local regs = bootState.CPU.registers
        R0  = regs[0];  R1  = regs[1];  R2  = regs[2];  R3  = regs[3]
        R4  = regs[4];  R5  = regs[5];  R6  = regs[6];  R7  = regs[7]
        R8  = regs[8];  R9  = regs[9];  R10 = regs[10]; R11 = regs[11]
        R12 = regs[12]; R13 = regs[13]; R14 = regs[14]; R15 = regs[15]
        R16 = regs[16]; R17 = regs[17]; R18 = regs[18]; R19 = regs[19]
        R20 = regs[20]; R21 = regs[21]; R22 = regs[22]; R23 = regs[23]
        R24 = regs[24]; R25 = regs[25]; R26 = regs[26]; R27 = regs[27]
        R28 = regs[28]; R29 = regs[29]; R30 = regs[30]; R31 = regs[31]
        pc = regs[33]
    end

{% for block in blocks %}
    blocks[{{ block.pc | hex }}] = function()
{{ block.body | indent(8, true) }}
    end
    block_insn_counts[{{ block.pc | hex }}] = {{ block.insn_count }}
{% endfor %}

    local function run()
        while bootState.is_running == 1 do
            local b = blocks[pc]
            if b then
                b()
            else
                sync_out()
                bootState.CPU:StepLegacy()
                sync_in()
            end
        end
    end

    return {
        run = run,
        blocks = blocks,
        block_insn_counts = block_insn_counts,
        sync_out = sync_out,
        sync_in = sync_in,
