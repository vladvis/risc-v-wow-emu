  aot.lua.j2 -- Jinja2 template rendering the full AOT Lua chunk.

  Shape (matches the design in the plan):

    _DW_DoomAOTChunk = function(bootState, memTable, ecallBridge, fpuBridge)
        local R0,R1,...,R31 = 0,...,0       -- 32-entry GPR bank
        local pc = <entrypoint>
        local mem = memTable
        local SHIFT8 = {1, 256, 65536, 16777216, 4294967296}
        local ecall = ecallBridge
        local fpu   = fpuBridge
        local blocks = {}

        <one blocks[0xPC] = function() ... end per discovered block>

        local function sync_out() <unrolled 32-way GPR + pc copy> end
        local function sync_in()  <reverse>                      end

        local function run()
            while bootState.is_running == 1 do
                local b = blocks[pc]
                if b then b() else sync_out(); bootState.CPU:StepLegacy(); sync_in() end
            end
        end

        return { run = run, blocks = blocks, sync_out = sync_out, sync_in = sync_in }
    end

  Template variables:
    entrypoint  - int, ELF e_entry
    blocks      - list of {pc: int, body: str, insn_count: int}
    block_count - len(blocks)
    insn_count  - total instruction snippets emitted (stats only)
    generator   - the script name (for the header comment)
    name        - symbolic program name (e.g. "doom")
