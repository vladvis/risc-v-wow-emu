-- addon-side ``src/aot.lua``) calls it once with the CPU bootstrap state,
-- the memory table, an ECALL bridge and an FPU bridge, and uses the
-- returned table's ``run`` method in place of the legacy interpreter's
-- ``CPU:Run()``.

_DW_DoomAOTChunk = function(bootState, memTable, ecallBridge, fpuBridge)
    local R0,R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11,R12,R13,R14,R15,
          R16,R17,R18,R19,R20,R21,R22,R23,R24,R25,R26,R27,R28,R29,R30,R31 =
