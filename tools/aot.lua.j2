    local pc = {{ entrypoint | hex }}
    local mem = memTable
    local SHIFT8 = {1, 256, 65536, 16777216, 4294967296}
    local ecall = ecallBridge
    local fpu = fpuBridge
    local blocks = {}

    -- Per-block static instruction count.  Used by the Lua-side lockstep
    -- verifier in src/aot.lua: the driver needs to know exactly how many
    -- times to single-step the legacy interpreter when re-executing a
    -- block, because just "step until pc matches AOT's post-pc" produces
    -- a false positive for any block whose backward-branch terminator
    -- targets an address *inside* the same block (e.g. the memset
    -- unrolled body at 0x59520, whose bltu targets 0x5952c which is only
    -- 12 bytes into the block).  This table is never read by the
    -- non-verify run path.
    local block_insn_counts = {}

    -- sync_out / sync_in are declared BEFORE the block closures so the
    -- blocks can reference them as upvalues.  Lua resolves upvalue names
    -- lexically at closure-creation time; declaring them after the blocks
    -- would leave the calls unresolved.
    local function sync_out()
        local regs = bootState.CPU.registers
        regs[0]  = R0;  regs[1]  = R1;  regs[2]  = R2;  regs[3]  = R3
        regs[4]  = R4;  regs[5]  = R5;  regs[6]  = R6;  regs[7]  = R7
        regs[8]  = R8;  regs[9]  = R9;  regs[10] = R10; regs[11] = R11
        regs[12] = R12; regs[13] = R13; regs[14] = R14; regs[15] = R15
        regs[16] = R16; regs[17] = R17; regs[18] = R18; regs[19] = R19
        regs[20] = R20; regs[21] = R21; regs[22] = R22; regs[23] = R23
        regs[24] = R24; regs[25] = R25; regs[26] = R26; regs[27] = R27
        regs[28] = R28; regs[29] = R29; regs[30] = R30; regs[31] = R31
        regs[33] = pc
